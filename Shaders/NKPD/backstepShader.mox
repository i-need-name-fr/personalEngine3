#include NKPD<<0>>
#include SceneBuffers<<1>>
#include SceneImages<<2>>

[NKPD]
{
    StorageBuffer NKPDGeneral<<ShaderBoth>>
    UniformBuffer inputOffsetBuffer<<ShaderRead>>
    UniformBuffer inputPtrBuffer<<ShaderRead>>
    StorageBuffer inputWeightBuffer<<ShaderRead>>
    StorageBuffer inputGradBuffer<<ShaderBoth>>
    UniformBuffer hiddenOffsetBuffer<<ShaderRead>>
    UniformBuffer hiddenPtrBuffer<<ShaderRead>>
    StorageBuffer hiddenWeightBuffer<<ShaderRead>>
    StorageBuffer hiddenGradBuffer<<ShaderBoth>>
    UniformBuffer outputOffsetBuffer<<ShaderRead>>
    UniformBuffer outputPtrBuffer<<ShaderRead>>
    StorageBuffer outputWeightBuffer<<ShaderRead>>
    StorageBuffer outputGradBuffer<<ShaderBoth>>
    StorageImage variancePool<<CURRENT , ShaderBoth>>
    StorageImage variancePool<<PREV , ShaderRead>>
}

[SceneBuffers]
{
    UniformBuffer generalBuffer<<ShaderRead>>
}

[SceneImages]
{
    StorageImage positionImage<<CURRENT , ShaderRead>>
    StorageImage positionImage<<PREV , ShaderRead>>
    StorageImage normalImage<<CURRENT , ShaderRead>>
    StorageImage normalImage<<PREV , ShaderRead>>
    StorageImage diffuseImage<<CURRENT , ShaderRead>>
    StorageImage diffuseImage<<PREV , ShaderRead>>
    StorageImage indirectImage<<CURRENT , ShaderRead>>
    StorageImage indirectImage<<PREV , ShaderRead>>
    StorageImage depthImage<<CURRENT , ShaderRead>>
    StorageImage diffuseDistance<<CURRENT , ShaderRead>>
    StorageImage indirectDistance<<CURRENT , ShaderRead>>
    StorageImage pixelCheck<<ShaderRead>>
    StorageImage motionVector<<ShaderRead>>
    StorageImage tmpDiffuseImage<<ShaderRead>>
    StorageImage rawSignalImage<<ShaderRead>>
    StorageImage diffuseHistoryImage<<ShaderRead>>
