#include SceneBuffers<<0>>
#include SceneImages<<1>>
#include AtmoScat<<2>>
#include VertexHeap<<3>>
#include TextureHub<<4>>
#include LightHub<<5>>
#include SceneReSTIR<<6>>
#include SharcHeap<<7>>
#include NRC<<8>>

[SceneBuffers]
{
    UniformBuffer generalBuffer<<ShaderRead>>
    UniformBuffer features<<ShaderRead>>
    UniformBuffer sunBuffer<<ShaderRead>>
}

[SceneImages]
{
    StorageImage positionImage<<CURRENT , ShaderRead>>
    StorageImage positionImage<<PREV , ShaderRead>>
    StorageImage normalImage<<CURRENT , ShaderRead>>
    StorageImage normalImage<<PREV , ShaderRead>>
    StorageImage indirectImage<<CURRENT , ShaderWrite>>
    StorageImage indirectDistance<<CURRENT , ShaderWrite>>
    StorageImage albedoImage<<ShaderRead>>
    StorageImage roughnessImage<<ShaderRead>>
    StorageImage metallicImage<<ShaderRead>>
    StorageImage pixelCheck<<ShaderRead>>
    Texture MultiScatterRoughness<<ShaderRead>>
}

[AtmoScat]
{
    Texture skybox<<ShaderRead>>
    Texture IBL<<ShaderRead>>
}

[LightHub]
{
    StorageBuffer lightBuffer<<ShaderRead>>
    StorageBuffer lightCellBuffer<<ShaderRead>>
    UniformBuffer lightCascadeBuffer<<ShaderRead>>
}

[SceneReSTIR]
{
    StorageBuffer ReSTIRPTBuffer<<CURRENT , ShaderWrite>>
    StorageBuffer ReSTIRPTBuffer<<PREV , ShaderRead>>
}

[NRC]
{
    StorageBuffer hashGridBuffer<<ShaderRead>>
    StorageBuffer HashGridInfos<<ShaderRead>>
    StorageBuffer inputWeightBuffer<<ShaderRead>>
    UniformBuffer inputOffsetBuffer<<ShaderRead>>
    UniformBuffer inputPtrBuffer<<ShaderRead>>
    StorageBuffer outputWeightBuffer<<ShaderRead>>
    UniformBuffer outputOffsetBuffer<<ShaderRead>>
    UniformBuffer outputPtrBuffer<<ShaderRead>>
}
