#include SceneBuffers<<0>>
#include SceneImages<<1>>
#include AtmoScat<<2>>
#include VertexHeap<<3>>
#include TextureHub<<4>>
#include LightHub<<5>>
#include SceneReSTIR<<6>>
#include SharcHeap<<7>>
#include NRC<<8>>

[SceneBuffers]
{
    UniformBuffer generalBuffer<<ShaderRead>>
    UniformBuffer features<<ShaderRead>>
    UniformBuffer sunBuffer<<ShaderRead>>
}

[SceneImages]
{
    StorageImage positionImage<<CURRENT , ShaderRead>>
    StorageImage positionImage<<PREV , ShaderRead>>
    StorageImage normalImage<<CURRENT , ShaderRead>>
    StorageImage normalImage<<PREV , ShaderRead>>
    StorageImage diffuseImage<<CURRENT , ShaderWrite>>
    StorageImage diffuseDistance<<CURRENT , ShaderWrite>>
    StorageImage specularImage<<CURRENT , ShaderWrite>>
    StorageImage specularDistance<<CURRENT , ShaderWrite>>
    StorageImage indirectDistance<<CURRENT , ShaderRead>>
    StorageImage albedoImage<<ShaderRead>>
    StorageImage roughnessImage<<ShaderRead>>
    StorageImage metallicImage<<ShaderRead>>
    StorageImage objectAOImage<<ShaderRead>>
    StorageImage shadowImage<<CURRENT , ShaderWrite>>
    StorageImage shadowImage<<PREV , ShaderRead>>
    StorageImage pixelCheck<<ShaderBoth>>
    StorageImage motionVector<<ShaderWrite>>
    StorageImage viewImage<<ShaderWrite>>
    Texture MultiScatterRoughness<<ShaderRead>>
}

[AtmoScat]
{
    Texture skybox<<ShaderRead>>
    Texture IBL<<ShaderRead>>
}

[LightHub]
{
    StorageBuffer lightBuffer<<ShaderRead>>
    StorageBuffer lightCellBuffer<<ShaderRead>>
    UniformBuffer lightCascadeBuffer<<ShaderRead>>
    StorageBuffer tileLightIndices<<ShaderRead>>
    StorageBuffer lightCountPerTile<<ShaderRead>>
    UniformBuffer forwardInfo<<ShaderRead>>
}

[SceneReSTIR]
{
    StorageBuffer ReSTIRGIBuffer<<PREV , ShaderRead>>
    StorageBuffer ReSTIRSSBuffer<<CURRENT , ShaderWrite>>
    StorageBuffer ReSTIRSSBuffer<<PREV , ShaderRead>>
}

[SharcHeap]
{
    StorageBuffer tableBuffer<<ShaderRead>>
    StorageBuffer tableInfoBuffer<<ShaderRead>>
}
