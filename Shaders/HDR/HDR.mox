#include SceneBuffers<<0>>
#include SceneImages<<1>>
#include BloomSource<<2>>

[SceneBuffers]
{
    UniformBuffer generalBuffer<<ShaderRead>>
    UniformBuffer features<<ShaderRead>>
    StorageBuffer EVBuffer<<ShaderRead>>
}

[SceneImages]
{
    StorageImage normalImage<<CURRENT , ShaderRead>>
    StorageImage albedoImage<<ShaderRead>>
    StorageImage roughnessImage<<ShaderRead>>
    StorageImage metallicImage<<ShaderRead>>
    StorageImage fShadowImage<<ShaderRead>>
    StorageImage fAmbientImage<<ShaderRead>>
    StorageImage DLSSImage<<ShaderRead>>
    StorageImage finalImage<<ShaderWrite>>
    StorageImage guiImage<<ShaderWrite>>
    StorageImage pixelCheck<<ShaderWrite>>
    StorageImage diffuseImage<<CURRENT , ShaderRead>>
    StorageImage specularImage<<CURRENT , ShaderRead>>
    StorageImage indirectImage<<CURRENT , ShaderRead>>
    StorageImage depthImage<<CURRENT , ShaderRead>>
    StorageImage objectAOImage<<ShaderRead>>
    StorageImage diffuseHistoryImage<<ShaderRead>>
    StorageImage positionImage<<CURRENT , ShaderRead>>
    StorageImage positionImage<<PREV , ShaderRead>>
    StorageImage normalImage<<PREV , ShaderRead>>
    StorageImage motionVector<<ShaderRead>>
}

[BloomSource]
{
    StorageImage bloomImages<<ShaderRead>>
}
